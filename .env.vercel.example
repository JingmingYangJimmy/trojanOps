# Vercel runtime variables. Use a dedicated cloud demo database and the restricted app role.
DATABASE_URL=postgresql://trojanops_app:REPLACE_WITH_STRONG_PASSWORD@YOUR_DATABASE_HOST/neondb?sslmode=require
DEMO_MODE=1
AGENT_RUNTIME=mock
CONNECTOR_IDENTITY=persona
CONNECTOR_ROSTER=csv
CONNECTOR_DOCUMENTS=upload
CONNECTOR_LLM=mock
CONNECTOR_APPLICATIONS=internal
# Leave DEMO_NOW unset on Vercel: the process-local demo clock is not shared across instances.
# DATABASE_OWNER_URL and DATABASE_APP_PASSWORD are for the local db:init CLI only.
# Do not add them to the Vercel runtime environment.
